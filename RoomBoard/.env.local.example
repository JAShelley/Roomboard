# Copy this file to `.env.local`.
# In Next.js browser-based Supabase auth uses public env vars, so place your
# Supabase project values in the NEXT_PUBLIC_* fields below.
#
# Supabase URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
#
# Supabase anon/public key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (Project Settings -> API)
# Server-only. Use this in your deployed Next.js app so Pulse addon API routes
# can read/write practice data securely on behalf of the logged-in user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Reference names from the product brief:
# SUPABASE_URL -> use NEXT_PUBLIC_SUPABASE_URL in this app
# SUPABASE_ANON_KEY -> use NEXT_PUBLIC_SUPABASE_ANON_KEY in this app
