# Copy this file to `.env.local`.
# In Next.js browser-based Supabase auth uses public env vars, so place your
# Supabase project values in the NEXT_PUBLIC_* fields below.
#
# Supabase URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
#
# Supabase anon/public key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (Project Settings -> API)
# Server-only. Use this in your deployed Next.js app so Pulse addon API routes
# can read/write practice data securely on behalf of the logged-in user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Reference names from the product brief:
# SUPABASE_URL -> use NEXT_PUBLIC_SUPABASE_URL in this app
# SUPABASE_ANON_KEY -> use NEXT_PUBLIC_SUPABASE_ANON_KEY in this app

# ---------------------------------------------------------------------------
# Stripe billing (server-only). Create these in the Stripe Dashboard.
# Use TEST-mode keys (sk_test_..., price ids from test products) while building.
# ---------------------------------------------------------------------------
# Secret API key (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Webhook signing secret (Developers -> Webhooks -> your endpoint -> Signing secret).
# For local testing here: stripe listen --forward-to localhost:3004/api/billing/webhook
# For Vercel, create the endpoint at https://your-domain.com/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Recurring Price IDs — two tiers, each with monthly + annual (Products -> Pricing)
STRIPE_PRICE_BASE_MONTHLY=price_your-base-monthly-price-id
STRIPE_PRICE_BASE_ANNUAL=price_your-base-annual-price-id
STRIPE_PRICE_ADVANCED_MONTHLY=price_your-advanced-monthly-price-id
STRIPE_PRICE_ADVANCED_ANNUAL=price_your-advanced-annual-price-id
